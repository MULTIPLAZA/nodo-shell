# ============================================================
# Cloudflare Pages — headers
# ============================================================

# HTML: nunca cachear (siempre buscar versión nueva)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

# Service Worker: NO cachear (clave para que updates lleguen rápido)
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Manifest: cache corto
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

# CSS / JS / íconos: cache largo (cambia el path o el query si querés bustear)
/styles/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Seguridad básica para todo
/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
